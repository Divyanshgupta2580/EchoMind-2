# ============================================================================
# TRON: Autonomous AI News Discovery and Publishing Platform - Local Configuration
# ============================================================================

# Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# Groq API Key (https://console.groq.com/keys)
GROQ_API_KEY=REPLACE_WITH_YOUR_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile

# Persistent Agent Memory Database Path (SQLite WAL)
AGENT_DB_PATH=./agent_memory.db

# Autonomous Newsroom Timing Configuration
DISCOVERY_INTERVAL_MINUTES=5
PUBLISH_WINDOW_MINUTES=120
MIN_NEWS_SCORE=75

# Web Server Port
PORT=8080