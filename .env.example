# ============================================================================
# EchoMind: Quality-Driven Autonomous X/Twitter News Publisher - Local Configuration
# ============================================================================

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=REPLACE_WITH_YOUR_OPENROUTER_API_KEY

# Official X / Twitter API Credentials (https://developer.x.com)
X_API_KEY=REPLACE_WITH_YOUR_X_API_KEY
X_API_SECRET=REPLACE_WITH_YOUR_X_API_SECRET
X_ACCESS_TOKEN=REPLACE_WITH_YOUR_X_ACCESS_TOKEN
X_ACCESS_TOKEN_SECRET=REPLACE_WITH_YOUR_X_ACCESS_TOKEN_SECRET
X_BEARER_TOKEN=REPLACE_WITH_YOUR_X_BEARER_TOKEN
EXPECTED_X_HANDLE=RASBASRYPI

# Persistent Agent Memory Database Path (SQLite WAL)
AGENT_DB_PATH=./agent_memory.db

# Autonomous Newsroom Timing Configuration
DISCOVERY_INTERVAL_MINUTES=5
PUBLISH_WINDOW_MINUTES=120
MIN_NEWS_SCORE=75

# Web Server Port
PORT=8080