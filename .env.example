# ============================================================================
# Autonomous AI & Technology Persona - Environment Configuration Template
# ============================================================================

# OpenRouter API Key (https://openrouter.ai/keys)
# Required for live LLM completions and live web search.
OPENROUTER_API_KEY=REPLACE_WITH_YOUR_OPENROUTER_API_KEY

# Persistent Agent Memory Database Path
# Local development default: ./agent_memory.db
# Render Web Service persistent disk mount: /data/agent_memory.db
AGENT_DB_PATH=./agent_memory.db

# Autonomous Publishing Background Cycle Interval (Minutes)
# Default is 2 minutes for continuous evaluation.
AGENT_INTERVAL_MINUTES=2

# Web Server Port (Render sets this dynamically via $PORT)
PORT=8080
