# ============================================================================
# EchoMind: Quality-Driven Autonomous X/Twitter News Publisher - Template
# ============================================================================

# OpenRouter API Key (https://openrouter.ai/keys)
# Required for live LLM completions and live web search.
OPENROUTER_API_KEY=REPLACE_WITH_YOUR_OPENROUTER_API_KEY

# Official X / Twitter API Credentials (https://developer.x.com)
# Required for autonomous publishing to X/Twitter.
X_API_KEY=REPLACE_WITH_YOUR_X_API_KEY
X_API_SECRET=REPLACE_WITH_YOUR_X_API_SECRET
X_ACCESS_TOKEN=REPLACE_WITH_YOUR_X_ACCESS_TOKEN
X_ACCESS_TOKEN_SECRET=REPLACE_WITH_YOUR_X_ACCESS_TOKEN_SECRET
X_BEARER_TOKEN=REPLACE_WITH_YOUR_X_BEARER_TOKEN

# Local SQLite Database Path (SQLite WAL mode)
# Works on local environments and Render Free Web Service instances without persistent disks.
AGENT_DB_PATH=./agent_memory.db

# Autonomous Newsroom Timing Configuration
# DISCOVERY_INTERVAL_MINUTES: continuous search & evaluation cadence (default: 5)
# PUBLISH_WINDOW_MINUTES: maximum 1 post per window duration (default: 120 / 2 hours)
# MIN_NEWS_SCORE: minimum quality score to qualify for publishing (default: 75.0)
DISCOVERY_INTERVAL_MINUTES=5
PUBLISH_WINDOW_MINUTES=120
MIN_NEWS_SCORE=75

# Web Server Port (Render sets this dynamically via $PORT)
PORT=8080
