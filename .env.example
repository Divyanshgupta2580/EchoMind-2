# ============================================================================
# EchoMind: Quality-Driven Autonomous AI & Technology News Publisher
# ============================================================================

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=REPLACE_WITH_YOUR_OPENROUTER_API_KEY

# Persistent Agent Memory Database Path (SQLite WAL)
AGENT_DB_PATH=./agent_memory.db

# Autonomous Newsroom Timing Configuration
DISCOVERY_INTERVAL_MINUTES=45
DISCOVERY_JITTER_SECONDS=300
PUBLISH_WINDOW_MINUTES=45
MIN_NEWS_SCORE=75

# Capacity Limit
MAX_AGENTS=5

# Web Server Port
PORT=8080